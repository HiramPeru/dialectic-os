# Infrastructure
DATABASE_URL=postgresql://dialectic:dialectic@localhost:5432/dialectic
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Remote analysis provider: nvidia or deepseek
LLM_PROVIDER=nvidia
LLM_MODEL=deepseek-ai/deepseek-v4-pro
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=4096

# Configure only the key used by LLM_PROVIDER
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
